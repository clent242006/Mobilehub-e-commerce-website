<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard - MobileHub</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-100">

<nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">MobileHub Admin</h1>

    <div class="space-x-6">
        <a href="/" class="hover:text-blue-400">Store</a>
        <a href="/admin" class="text-blue-400">Dashboard</a>
        <a href="/admin/products/add" class="hover:text-blue-400">Add Product</a>
        <a href="/admin/orders" class="hover:text-blue-400">Orders</a>
    </div>
</nav>

<div class="max-w-6xl mx-auto px-6 py-10">

    <h2 class="text-3xl font-bold mb-8">
        Admin Dashboard
    </h2>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">

        <div class="bg-white rounded-xl shadow-md p-6">
            <p class="text-gray-500">Total Products</p>

            <p class="text-4xl font-bold text-blue-600 mt-2">
                <%= products.length %>
            </p>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6">
            <p class="text-gray-500">Total Orders</p>

            <p class="text-4xl font-bold text-green-600 mt-2">
                <%= orders.length %>
            </p>
        </div>

    </div>

    <!-- Products -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-10">

        <div class="flex justify-between items-center mb-6">

            <h2 class="text-2xl font-bold">
                Products
            </h2>

            <a
                href="/admin/products/add"
                class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700"
            >
                + Add Product
            </a>

        </div>

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead>
                    <tr class="border-b">
                        <th class="text-left p-3">ID</th>
                        <th class="text-left p-3">Name</th>
                        <th class="text-left p-3">Price</th>
                        <th class="text-left p-3">Stock</th>
                        <th class="text-left p-3">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% products.forEach(product => { %>

                        <tr class="border-b hover:bg-gray-50">

                            <td class="p-3">
                                <%= product.id %>
                            </td>

                            <td class="p-3 font-semibold">
                                <%= product.name %>
                            </td>

                            <td class="p-3">
                                ₱<%= product.price.toLocaleString() %>
                            </td>

                            <td class="p-3">
                                <%= product.stock %>
                            </td>

                            <td class="p-3">

                                <a
                                    href="/admin/products/edit/<%= product.id %>"
                                    class="text-blue-600 hover:underline mr-4"
                                >
                                    Edit
                                </a>

                                <form
                                    action="/admin/products/delete/<%= product.id %>"
                                    method="POST"
                                    class="inline"
                                    onsubmit="return confirm('Are you sure you want to delete this product?')"
                                >

                                    <button
                                        type="submit"
                                        class="text-red-600 hover:underline"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <!-- Recent Orders -->
    <div class="bg-white rounded-xl shadow-md p-6">

        <h2 class="text-2xl font-bold mb-6">
            Recent Orders
        </h2>

        <% if (orders.length === 0) { %>

            <p class="text-gray-500">
                No orders yet.
            </p>

        <% } else { %>

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead>
                        <tr class="border-b">
                            <th class="text-left p-3">Order ID</th>
                            <th class="text-left p-3">Customer</th>
                            <th class="text-left p-3">Total</th>
                            <th class="text-left p-3">Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% orders.slice(0, 5).forEach(order => { %>

                            <tr class="border-b">

                                <td class="p-3">
                                    #<%= order.id %>
                                </td>

                                <td class="p-3">
                                    <%= order.customer_name %>
                                </td>

                                <td class="p-3 font-semibold">
                                    ₱<%= order.total.toLocaleString() %>
                                </td>

                                <td class="p-3">
                                    <%= order.status %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

            <div class="mt-6">

                <a
                    href="/admin/orders"
                    class="inline-block bg-gray-900 text-white px-5 py-2 rounded-lg hover:bg-gray-700"
                >
                    Manage All Orders
                </a>

            </div>

        <% } %>

    </div>

</div>

</body>
</html>