<!DOCTYPE html>
<html>
<head>
    <title>Add Product - MobileHub</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-100">

<nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">MobileHub Admin</h1>

    <div class="space-x-6">
        <a href="/" class="hover:text-blue-400">Store</a>
        <a href="/admin" class="hover:text-blue-400">Dashboard</a>
        <a href="/admin/products/add" class="text-blue-400">Add Product</a>
        <a href="/admin/orders" class="hover:text-blue-400">Orders</a>
    </div>
</nav>

<div class="max-w-2xl mx-auto px-6 py-10">

    <div class="bg-white rounded-xl shadow-md p-8">

        <h2 class="text-3xl font-bold mb-8">
            Add New Product
        </h2>

        <form action="/admin/products/add" method="POST">

            <label class="block font-semibold mb-2">
                Product Name
            </label>

            <input
                type="text"
                name="name"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Example: iPhone 16"
            >

            <label class="block font-semibold mb-2">
                Description
            </label>

            <textarea
                name="description"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 h-28 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Enter product description"
            ></textarea>

            <label class="block font-semibold mb-2">
                Price
            </label>

            <input
                type="number"
                name="price"
                required
                min="0"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="45000"
            >

            <label class="block font-semibold mb-2">
                Stock
            </label>

            <input
                type="number"
                name="stock"
                required
                min="0"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="10"
            >

            <label class="block font-semibold mb-2">
                Category
            </label>

            <select
                name="category_id"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-8 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
                <option value="1">iPhone</option>
                <option value="2">Samsung</option>
                <option value="3">Xiaomi</option>
            </select>

            <div class="flex gap-4">

                <button
                    type="submit"
                    class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700"
                >
                    Add Product
                </button>

                <a
                    href="/admin"
                    class="bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-300"
                >
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

</body>
</html>