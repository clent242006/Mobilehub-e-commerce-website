<!DOCTYPE html>
<html>
<head>
    <title><%= product.name %> - MobileHub</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-100">

<nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">MobileHub</h1>

    <div class="space-x-6">
        <a href="/" class="hover:text-blue-400">Home</a>
        <a href="/products" class="hover:text-blue-400">Products</a>
        <a href="/cart" class="hover:text-blue-400">Cart</a>
        <a href="/admin" class="hover:text-blue-400">Admin</a>
    </div>
</nav>

<div class="max-w-2xl mx-auto my-12 px-6">

    <div class="bg-white rounded-xl shadow-md p-8 text-center">

        <h2 class="text-3xl font-bold text-gray-900 mb-4">
            <%= product.name %>
        </h2>

        <p class="text-gray-600 mb-6">
            <%= product.description %>
        </p>

        <p class="text-3xl font-bold text-blue-600 mb-4">
            ₱<%= product.price.toLocaleString() %>
        </p>

        <p class="text-gray-500 mb-6">
            Available Stock: <%= product.stock %>
        </p>

        <% if (product.stock > 0) { %>

            <form action="/cart/add/<%= product.id %>" method="POST">

                <button
                    type="submit"
                    class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700"
                >
                    Add to Cart
                </button>

            </form>

        <% } else { %>

            <p class="text-red-600 font-bold">
                Out of Stock
            </p>

        <% } %>

        <a
            href="/products"
            class="inline-block mt-6 text-blue-600 hover:underline"
        >
            ← Back to Products
        </a>

    </div>

</div>

</body>
</html>