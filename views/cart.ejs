<!DOCTYPE html>
<html>
<head>
    <title>Cart - MobileHub</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-100">

<nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">MobileHub</h1>

    <div class="space-x-6">
        <a href="/" class="hover:text-blue-400">Home</a>
        <a href="/products" class="hover:text-blue-400">Products</a>
        <a href="/cart" class="text-blue-400">Cart</a>
        <a href="/admin" class="hover:text-blue-400">Admin</a>
    </div>
</nav>

<div class="max-w-4xl mx-auto my-10 px-6">

    <h2 class="text-3xl font-bold text-center mb-8">
        Your Shopping Cart
    </h2>

    <% if (cart.length === 0) { %>

        <div class="bg-white rounded-xl shadow-md p-8 text-center">

            <p class="text-gray-600 text-lg mb-6">
                Your cart is empty.
            </p>

            <a
                href="/products"
                class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700"
            >
                Continue Shopping
            </a>

        </div>

    <% } else { %>

        <div class="bg-white rounded-xl shadow-md p-6">

            <% cart.forEach(item => { %>

                <div class="border-b py-5 flex justify-between items-center">

                    <div>
                        <h3 class="text-xl font-bold">
                            <%= item.name %>
                        </h3>

                        <p class="text-gray-500">
                            ₱<%= item.price.toLocaleString() %>
                            × <%= item.quantity %>
                        </p>
                    </div>

                    <p class="text-lg font-bold text-blue-600">
                        ₱<%= (item.price * item.quantity).toLocaleString() %>
                    </p>

                </div>

            <% }) %>

            <div class="flex justify-between items-center mt-6">

                <h3 class="text-2xl font-bold">
                    Total
                </h3>

                <p class="text-2xl font-bold text-blue-600">
                    ₱<%= total.toLocaleString() %>
                </p>

            </div>

            <div class="text-right mt-6">

                <a
                    href="/checkout"
                    class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700"
                >
                    Proceed to Checkout
                </a>

            </div>

        </div>

    <% } %>

</div>

</body>
</html>