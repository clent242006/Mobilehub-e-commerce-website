<!DOCTYPE html>
<html>
<head>
    <title>Checkout - MobileHub</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-100">

<nav class="bg-gray-900 text-white px-6 py-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">MobileHub</h1>

    <div class="space-x-6">
        <a href="/" class="hover:text-blue-400">Home</a>
        <a href="/products" class="hover:text-blue-400">Products</a>
        <a href="/cart" class="hover:text-blue-400">Cart</a>
        <a href="/admin" class="hover:text-blue-400">Admin</a>
    </div>
</nav>

<div class="max-w-2xl mx-auto my-10 px-6">

    <div class="bg-white rounded-xl shadow-md p-8">

        <h2 class="text-3xl font-bold text-center mb-8">
            Checkout
        </h2>

        <div class="bg-gray-100 rounded-lg p-4 mb-6">
            <p class="text-gray-600">Order Total</p>

            <p class="text-2xl font-bold text-blue-600">
                ₱<%= total.toLocaleString() %>
            </p>
        </div>

        <form action="/checkout" method="POST">

            <label class="block font-semibold mb-2">
                Full Name
            </label>

            <input
                type="text"
                name="customer_name"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Enter your full name"
            >

            <label class="block font-semibold mb-2">
                Email
            </label>

            <input
                type="email"
                name="customer_email"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Enter your email"
            >

            <label class="block font-semibold mb-2">
                Delivery Address
            </label>

            <textarea
                name="address"
                required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 mb-6 h-28 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Enter your delivery address"
            ></textarea>

            <button
                type="submit"
                class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700"
            >
                Place Order
            </button>

        </form>

    </div>

</div>

</body>
</html>